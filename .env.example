# Neon (Vercel)
DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30"
DIRECT_URL="postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

AUTH_SECRET="generate-with: openssl rand -base64 32"
# Optional on Vercel (trustHost). If set, must be the public URL — never localhost in prod.
# AUTH_URL="https://your-app.vercel.app"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ADMIN_EMAILS="you@gmail.com"
